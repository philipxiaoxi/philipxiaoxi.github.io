---
import { NAV_LINKS, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialIcon from './SocialIcon.astro';
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<div class="internal-links">
			{NAV_LINKS.map((link) => <HeaderLink href={link.href}>{link.label}</HeaderLink>)}
		</div>
		<div class="social-links">
			{
				SOCIAL_LINKS.map((link) => (
					<a
						href={link.href}
						target={link.external ? '_blank' : undefined}
						rel={link.external ? 'noopener noreferrer' : undefined}
						title={link.label}
					>
						<span class="sr-only">{link.label}</span>
						<SocialIcon name={link.icon} />
					</a>
				))
			}
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		margin: 0;
		padding: env(safe-area-inset-top) max(1.25rem, env(safe-area-inset-right)) 0
			max(1.25rem, env(safe-area-inset-left));
		min-height: calc(var(--header-height) + env(safe-area-inset-top));
		height: auto;
		display: flex;
		align-items: center;
		background: rgba(255, 252, 248, 0.82);
		backdrop-filter: blur(12px) saturate(1.2);
		-webkit-backdrop-filter: blur(12px) saturate(1.2);
		border-bottom: 1px solid rgba(var(--line), 0.75);
	}

	nav {
		width: min(var(--wide-width), 100%);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.brand {
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: -0.02em;
		color: rgb(var(--ink));
		text-decoration: none;
		white-space: nowrap;
	}

	.brand:hover {
		color: var(--accent-dark);
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}

	.internal-links :global(a) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.45rem 0.75rem;
		color: rgb(var(--ink-muted));
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		border-radius: 999px;
		border-bottom: none;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.internal-links :global(a:hover) {
		color: rgb(var(--ink));
		background: rgba(var(--line), 0.45);
	}

	.internal-links :global(a.active) {
		color: var(--accent-dark);
		background: var(--accent-soft);
		font-weight: 700;
		text-decoration: none;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 999px;
		color: rgb(var(--ink-muted));
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.social-links a:hover {
		color: var(--accent-dark);
		background: var(--accent-soft);
	}

	@media (max-width: 640px) {
		header {
			padding: env(safe-area-inset-top) max(0.75rem, env(safe-area-inset-right)) 0
				max(0.75rem, env(safe-area-inset-left));
		}

		.social-links {
			display: none;
		}

		.internal-links :global(a) {
			min-height: 2.75rem;
			padding: 0.5rem 0.7rem;
			font-size: 0.9rem;
		}
	}
</style>
