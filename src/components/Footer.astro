---
import { SITE_AUTHOR, SITE_TAGLINE, SOCIAL_LINKS } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="motto">{SITE_TAGLINE}</p>
		<div class="meta">
			<span>&copy; {today.getFullYear()} {SITE_AUTHOR}</span>
			<span class="dot" aria-hidden="true">·</span>
			<div class="social-links">
				{
					SOCIAL_LINKS.map((link) => (
						<a
							href={link.href}
							target={link.icon === 'email' ? undefined : '_blank'}
							rel={link.icon === 'email' ? undefined : 'noopener noreferrer'}
						>
							{link.label}
						</a>
					))
				}
			</div>
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 2.5rem max(1.25rem, env(safe-area-inset-right))
			max(3.5rem, calc(2rem + env(safe-area-inset-bottom))) max(1.25rem, env(safe-area-inset-left));
		border-top: 1px solid rgba(var(--line), 0.75);
		background: rgba(255, 252, 248, 0.55);
	}

	.footer-inner {
		width: min(var(--content-width), 100%);
		margin: 0 auto;
		text-align: center;
	}

	.motto {
		margin: 0 0 1rem;
		color: rgb(var(--ink-muted));
		font-size: 0.95rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.5rem 0.65rem;
		color: rgb(var(--ink-muted));
		font-size: 0.88rem;
	}

	.dot {
		opacity: 0.5;
	}

	.social-links {
		display: flex;
		gap: 0.85rem;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		padding: 0.35rem 0.25rem;
		color: rgb(var(--ink-muted));
		text-decoration: none;
		font-weight: 600;
	}

	.social-links a:hover {
		color: var(--accent-dark);
	}
</style>
