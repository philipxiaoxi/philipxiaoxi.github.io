---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import {
	ABOUT_INTRO,
	SITE_DESCRIPTION,
	SITE_EMAIL,
	SITE_TAGLINE,
	SITE_TITLE,
	TECH_FOCUS,
} from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero section">
				<p class="eyebrow">个人技术博客</p>
				<h1>{SITE_TITLE}</h1>
				<p class="lead">{SITE_DESCRIPTION}</p>
			</section>

			<section class="section" id="about">
				<h2 class="section-label"><span class="emoji" aria-hidden="true">👋</span> 关于我</h2>
				<div class="card about-card">
					{ABOUT_INTRO.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</section>

			<section class="section" id="focus">
				<h2 class="section-label"><span class="emoji" aria-hidden="true">🔧</span> 技术方向</h2>
				<div class="table-wrap">
					<table class="focus-table">
						<thead>
							<tr>
								<th scope="col">领域</th>
								<th scope="col">内容</th>
							</tr>
						</thead>
						<tbody>
							{
								TECH_FOCUS.map((item) => (
									<tr>
										<td class="area">
											<span class="emoji" aria-hidden="true">
												{item.icon}
											</span>
											{item.area}
										</td>
										<td>{item.detail}</td>
									</tr>
								))
							}
						</tbody>
					</table>
				</div>
			</section>

			<section class="section" id="contact">
				<h2 class="section-label"><span class="emoji" aria-hidden="true">📌</span> 联系我</h2>
				<div class="card">
					<ul class="contact-list">
						<li>
							邮箱：
							<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
						</li>
						<li>
							GitHub：
							<a href="https://github.com/philipxiaoxi" target="_blank" rel="noopener noreferrer"
								>philipxiaoxi</a
							>
							（欢迎 Star ⭐）
						</li>
					</ul>
				</div>
				<p class="site-motto">{SITE_TAGLINE}</p>
			</section>

			<section class="section" id="posts">
				<h2 class="section-label"><span class="emoji" aria-hidden="true">✍️</span> 最近文章</h2>
				{
					recentPosts.length === 0 ? (
						<p class="empty">还没有文章，稍后再来看看。</p>
					) : (
						<ul class="card-list">
							{recentPosts.map((post) => (
								<li>
									<a class="post-card" href={`/blog/${post.id}/`}>
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-meta">
											<FormattedDate date={post.data.pubDate} />
										</p>
										{post.data.description && <p class="post-desc">{post.data.description}</p>}
									</a>
								</li>
							))}
						</ul>
					)
				}
				<a class="link-more" href="/blog">查看全部文章</a>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero h1 {
		margin-bottom: 0.75rem;
	}

	.eyebrow {
		display: inline-block;
		margin: 0 0 0.75rem;
		padding: 0.25rem 0.7rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--accent-dark);
		background: var(--accent-soft);
		border-radius: 999px;
	}

	.about-card p:last-child {
		margin-bottom: 0;
	}

	.table-wrap {
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.empty {
		color: rgb(var(--ink-muted));
	}
</style>
