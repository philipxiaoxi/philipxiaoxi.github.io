---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const recentPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				margin-bottom: 2.5em;
			}
			.hero h1 {
				margin-bottom: 0.25em;
			}
			.hero .tagline {
				color: rgb(var(--gray));
				font-size: 1.15em;
				margin-bottom: 1em;
			}
			.section-title {
				font-size: 1.563em;
				margin-bottom: 1em;
			}
			.post-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-list li {
				margin-bottom: 1.5em;
			}
			.post-list a {
				text-decoration: none;
				color: inherit;
			}
			.post-list a:hover .post-title {
				color: var(--accent);
			}
			.post-title {
				margin: 0 0 0.25em 0;
				font-size: 1.25em;
				line-height: 1.3;
			}
			.post-meta {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.post-desc {
				margin: 0.35em 0 0 0;
				color: rgb(var(--gray-dark));
				font-size: 0.95em;
			}
			.more {
				margin-top: 1.5em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p class="tagline">{SITE_DESCRIPTION}</p>
				<p>
					这里是我的个人技术博客：写软件工程里踩过的坑、学到的方法和日常折腾。内容尽量简短、可复现，欢迎一起交流。
				</p>
			</section>

			<section>
				<h2 class="section-title">最近文章</h2>
				{
					recentPosts.length === 0 ? (
						<p>还没有文章，稍后再来看看。</p>
					) : (
						<ul class="post-list">
							{recentPosts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<h3 class="post-title">{post.data.title}</h3>
										<p class="post-meta">
											<FormattedDate date={post.data.pubDate} />
										</p>
										{post.data.description && <p class="post-desc">{post.data.description}</p>}
									</a>
								</li>
							))}
						</ul>
					)
				}
				<p class="more">
					<a href="/blog">查看全部文章 →</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
