---
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatListDate(date: Date) {
	return date.toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	});
}
---

<BaseLayout title={`练习室 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} mainClass="wide">
	<header class="page-hero">
		<p class="kicker">Blog</p>
		<h1 class="page-title">练习室</h1>
		<p class="subtitle">踩坑记录、工程实践与折腾笔记。</p>
	</header>

	{
		posts.length === 0 ? (
			<p class="empty">还没有文章。</p>
		) : (
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<a class="post-row" href={`/blog/${post.id}/`}>
							<time class="date" datetime={post.data.pubDate.toISOString()}>
								{formatListDate(post.data.pubDate)}
							</time>
							<div class="body">
								<h2 class="title">{post.data.title}</h2>
								{post.data.description && <p class="desc">{post.data.description}</p>}
							</div>
						</a>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	/* Apple Newsroom 式：大留白、细线分割、日期栏 + 标题栏 */
	.page-hero {
		padding: 1.25rem 0 2.75rem;
		margin-bottom: 0.25rem;
	}

	.kicker {
		margin: 0 0 0.65rem;
		font-size: 0.78rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(var(--ink-muted));
	}

	.page-title {
		margin: 0 0 0.75rem;
		font-size: clamp(2.5rem, 5.5vw, 3.5rem);
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.08;
	}

	.subtitle {
		margin: 0;
		max-width: 28rem;
		font-size: 1.125rem;
		line-height: 1.45;
		letter-spacing: -0.01em;
		color: rgb(var(--ink-muted));
		font-weight: 400;
	}

	.empty {
		margin: 2rem 0 0;
		color: rgb(var(--ink-muted));
	}

	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid rgba(var(--line), 0.95);
	}

	.post-list li {
		border-bottom: 1px solid rgba(var(--line), 0.95);
	}

	.post-row {
		display: grid;
		grid-template-columns: 7.5rem minmax(0, 1fr);
		align-items: start;
		gap: 1.25rem 1.75rem;
		padding: 1.85rem 0.15rem;
		text-decoration: none;
		color: inherit;
		transition: opacity 0.2s ease;
	}

	.post-row:hover {
		color: inherit;
		opacity: 0.72;
	}

	.post-row:hover .title {
		color: rgb(var(--ink));
	}

	.post-row:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
		border-radius: 6px;
		opacity: 1;
	}

	.date {
		margin: 0.35rem 0 0;
		font-size: 0.9rem;
		line-height: 1.35;
		letter-spacing: -0.01em;
		color: rgb(var(--ink-muted));
		font-variant-numeric: tabular-nums;
		font-weight: 400;
	}

	.body {
		min-width: 0;
	}

	.title {
		margin: 0;
		font-size: clamp(1.2rem, 2.2vw, 1.45rem);
		font-weight: 600;
		line-height: 1.28;
		letter-spacing: -0.025em;
		color: rgb(var(--ink));
	}

	.desc {
		margin: 0.55rem 0 0;
		max-width: 38rem;
		font-size: 1rem;
		line-height: 1.5;
		letter-spacing: -0.01em;
		color: rgb(var(--ink-muted));
	}

	@media (max-width: 720px) {
		.page-hero {
			padding: 0.5rem 0 1.75rem;
		}

		.post-row {
			grid-template-columns: 1fr;
			gap: 0.35rem;
			padding: 1.4rem 0;
		}

		.date {
			margin: 0;
			font-size: 0.82rem;
		}

		.title {
			font-size: 1.15rem;
		}

		.desc {
			font-size: 0.95rem;
			margin-top: 0.4rem;
		}
	}
</style>
