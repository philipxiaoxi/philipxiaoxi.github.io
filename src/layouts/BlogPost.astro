---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				{
					heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)
				}
				<div class="prose">
					<header class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										更新于 <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{description && <p class="summary">{description}</p>}
						<hr />
					</header>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero-image {
		/* main 已约束版心与左右边距，此处铺满即可，避免二次收窄 */
		width: 100%;
		margin: 0 auto 1.5rem;
	}

	.hero-image :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		box-shadow: var(--shadow-md);
		border: 1px solid rgba(var(--line), 0.7);
	}

	.prose {
		width: 100%;
		max-width: 100%;
		margin: 0 auto;
		color: rgb(var(--gray-dark));
		/* 宽表格可横向滑动 */
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	/* scoped 样式默认不穿透 slot 里的 Markdown 节点，用 :global 补一层 */
	.prose :global(table) {
		width: 100%;
		margin: 1.25em 0 1.75em;
		border-collapse: separate;
		border-spacing: 0;
		font-size: 0.92rem;
		line-height: 1.55;
		border: 1px solid rgba(var(--line), 0.9);
		border-radius: var(--radius-sm);
		background: var(--paper-elevated);
		box-shadow: var(--shadow-sm);
	}

	.prose :global(thead th) {
		background: rgba(var(--line), 0.4);
		color: rgb(var(--ink-muted));
		font-weight: 700;
		font-size: 0.85rem;
		text-align: left;
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 0.7rem 0.95rem;
		border-bottom: 1px solid rgba(var(--line), 0.8);
		vertical-align: top;
	}

	.prose :global(tbody tr:last-child th),
	.prose :global(tbody tr:last-child td) {
		border-bottom: none;
	}

	.prose :global(tbody tr:hover td),
	.prose :global(tbody tr:hover th) {
		background: rgba(243, 224, 212, 0.28);
	}

	.title {
		margin-bottom: 1.5rem;
		text-align: left;
	}

	.title h1 {
		margin: 0 0 0.65rem;
	}

	.date {
		margin-bottom: 0.65rem;
		color: rgb(var(--ink-muted));
		font-size: 0.92rem;
	}

	.last-updated-on {
		margin-top: 0.2rem;
		font-style: italic;
	}

	.summary {
		margin: 0 0 1rem;
		color: rgb(var(--ink-muted));
		font-size: 1.05rem;
		line-height: 1.6;
	}

	.prose :global(h2),
	.prose :global(h3) {
		margin-top: 1.75em;
	}

	.prose :global(a) {
		font-weight: 600;
	}
</style>
